# --- LLM (Groq, free tier, compatible con la API de OpenAI) ---
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=openai/gpt-oss-120b
GUARD_MODEL=openai/gpt-oss-safeguard-20b

# --- TMDB: Settings > API > "API Read Access Token" (uso no comercial, CC3116 UVG) ---
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=es-MX
TMDB_DAILY_LIMIT=1000

# --- Google Books (sin tarjeta de crédito; la key es opcional pero sube la cuota) ---
GOOGLE_BOOKS_API_KEY=
BOOKS_DAILY_LIMIT=1000

# --- Caché y cuotas compartidas entre réplicas. Vacío = caché en memoria (solo desarrollo) ---
REDIS_URL=

# --- MCP servers ---
MCP_HOST=127.0.0.1
TMDB_MCP_PORT=8101
BOOKS_MCP_PORT=8102
REFERENCES_MCP_PORT=8103
TMDB_MCP_URL=http://127.0.0.1:8101/mcp
BOOKS_MCP_URL=http://127.0.0.1:8102/mcp
REFERENCES_MCP_URL=http://127.0.0.1:8103/mcp

# --- Gateway WebSocket ---
GATEWAY_PORT=8000
# Orígenes (sitios) autorizados a usar el widget, separados por comas
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4173
