{
  "name": "@agichat/widget-sdk",
  "version": "1.0.0",
  "description": "SDK de widget de chat embebible para AGIChat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josero31/Proyecto-1IA.git"
  },
  "bugs": {
    "url": "https://github.com/Josero31/Proyecto-1IA/issues"
  },
  "homepage": "https://github.com/Josero31/Proyecto-1IA#readme",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/agichat-widget-sdk.umd.cjs",
  "module": "./dist/agichat-widget-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agichat-widget-sdk.js",
      "require": "./dist/agichat-widget-sdk.umd.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm size"
  },
  "keywords": [
    "chat",
    "widget",
    "sdk",
    "agent",
    "web-component"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  }
}
